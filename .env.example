# Copy this file to .env and replace every blank value using your ai&
# Inference API documentation/dashboard. Values here are only placeholders.
# Never commit the resulting .env file or share the real API key.

# Exact OpenAI-compatible base URL supplied by your provider.
# Follow the provider documentation about whether the URL should end in /v1.
AI_BASE_URL=

# Your ai& Inference API key. Do not put this value in source code or logs.
AI_API_KEY=

# Exact model ID from your provider's model list. The model must support
# native function/tool calling; no model ID is assumed by this project.
AI_MODEL=
